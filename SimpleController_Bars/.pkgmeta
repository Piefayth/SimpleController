# Packages Simple Controller: Bars alone (BigWigsMods packager,
# -m SimpleController_Bars/.pkgmeta). It needs the core, SimpleController, its own
# project, named in the .toc's Dependencies for the game. CurseForge's relation
# (required-dependencies: simplecontroller) returns once the core's project is public:
# CurseForge refuses a relation to one still in moderation (2026-11-24).
package-as: SimpleController_Bars

move-folders:
  SimpleController_Bars/SimpleController_Bars: SimpleController_Bars

ignore:
  - README.md
  - RELEASING.md
  - SimpleController
  - SimpleController_Spin
  - SimpleController_Wheels
