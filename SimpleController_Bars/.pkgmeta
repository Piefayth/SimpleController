# Packages Simple Controller: Bars alone (BigWigsMods packager,
# -m SimpleController_Bars/.pkgmeta). It needs the core, SimpleController, its own
# project: named here as a required dependency (CurseForge's slug), so the addon
# sites install it beside this one, and in the .toc's Dependencies for the game.
package-as: SimpleController_Bars

move-folders:
  SimpleController_Bars/SimpleController_Bars: SimpleController_Bars

required-dependencies:
  - simplecontroller

ignore:
  - README.md
  - RELEASING.md
  - SimpleController
  - SimpleController_Spin
  - SimpleController_Wheels
