# Packages SimpleController_Spin alone (BigWigsMods packager, run with
# -m SimpleController_Spin/.pkgmeta). The packager copies the whole repository into
# .release/SimpleController_Spin, so everything that is not this addon is ignored,
# then this folder's contents are moved up to be the addon's folder.
package-as: SimpleController_Spin

move-folders:
  SimpleController_Spin/SimpleController_Spin: SimpleController_Spin

ignore:
  - README.md
  - RELEASING.md
  - tests
  - SimpleController_Bars
